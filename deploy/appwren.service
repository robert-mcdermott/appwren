# AppWren as a systemd service, with the sandboxing systemd offers switched on.
#
#   sudo useradd --system --home-dir /var/lib/appwren --shell /usr/sbin/nologin appwren
#   sudo install -d -o appwren -g appwren -m 700 /var/lib/appwren
#   sudo install -d -m 755 /etc/appwren                    # appwren.toml goes here
#   sudo install -m 600 /dev/null /etc/appwren/secrets.env  # PGPASSWORD=... and the like
#   sudo cp deploy/appwren.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now appwren
#
# This expects the code at /opt/appwren with `uv sync --no-dev --extra postgres` run there,
# and [data] home = "/var/lib/appwren" in /etc/appwren/appwren.toml.

[Unit]
Description=AppWren
Documentation=https://robert-mcdermott.github.io/appwren/
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=appwren
Group=appwren
WorkingDirectory=/opt/appwren
Environment=APPWREN_CONFIG=/etc/appwren/appwren.toml
EnvironmentFile=-/etc/appwren/secrets.env
ExecStartPre=/opt/appwren/.venv/bin/appwren db upgrade
ExecStart=/opt/appwren/.venv/bin/appwren serve
Restart=on-failure
RestartSec=5

# Only what it needs, and nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/appwren
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
